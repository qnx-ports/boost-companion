# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=boost
pkgver=1.89.0
_pkgver="${pkgver//./_}"
pkgrel=0
pkgdesc="Free peer-reviewed portable C++ source libraries"
url="https://www.boost.org/"
arch="all"
license="BSL-1.0"
depends="$pkgname-libs libc++"
depends_dev="$pkgname bzip2-dev icu-dev xz-dev zlib-dev zstd-dev clang libc++-dev"
makedepends="$depends_dev python3-dev>=3.8 flex bison"
subpackages="
	$pkgname-static
	$pkgname-dev
	$pkgname-doc
	"
options="!check" # taks too long
source="https://archives.boost.io/release/$pkgver/source/boost_$_pkgver.tar.bz2
	"
builddir="$srcdir/boost_$_pkgver"

_libs="
	atomic
	chrono
	container
	context
	contract
	coroutine
	date_time
	fiber
	filesystem
	graph
	iostreams
	locale
	log_setup
	log
	math
	prg_exec_monitor
	program_options
	python3
	random
	regex
	serialization
	stacktrace_basic
	stacktrace_noop
	thread
	timer
	type_erasure
	unit_test_framework
	url
	wave
	wserialization
	json
	nowide
	"
for _lib in $_libs; do
	subpackages="$subpackages $pkgname-$_lib:_boostlib"
	depends_libs="$depends_libs $pkgname-$_lib"
done; unset -v _lib
subpackages="$subpackages $pkgname-libs"

_set_options() {
	local _python="$(_pyversion python3)"
	export PY3_VERSION="$_python"
	export BOOST_ROOT="$builddir"

	_options="
		variant=release
		python=$PY3_VERSION
		toolset=clang
		cxxstd=23
		debug-symbols=off
		threading=multi
		runtime-link=shared
		link=shared,static
		cflags=-fno-strict-aliasing
		--without-mpi
		--layout=system
		-q
		-j${JOBS:-2}
		"
}

prepare() {
	default_prepare
	_set_options

	local abiflags="$(python3-config --abiflags)"

	# create user-config.jam
	cat > user-config.jam <<-__EOF__

	using clang : : clang++ : <cflags>"$CFLAGS" <cxxflags>"$CXXFLAGS -DSA_RESTART=0" <linkflags>"$LDFLAGS" ;
	using python : $PY3_VERSION : /usr/bin/python3 : /usr/include/python${PY3_VERSION}$abiflags : : : : $abiflags ;

	__EOF__
}

build() {
	_set_options

	msg "Building b2"
	cd "$builddir"/tools/build
	./bootstrap.sh --cxxflags="$CXXFLAGS $LDFLAGS"

	msg "Building bcp"
	cd "$builddir"/tools/bcp
	../build/b2 -j${JOBS:-2} toolset=clang

	msg "Building boost"
	cd "$builddir"
	./bootstrap.sh --with-toolset=clang --with-icu --with-python=python3
	./b2 --user-config="$builddir/user-config.jam" --prefix="$pkgdir/usr" $_options
}

check() {
	cd "$builddir"/tools/build/test

	PATH="$builddir:$PATH" python3 test_all.py clang
}

package() {
	_set_options

	install -Dm644 LICENSE_1_0.txt \
		"$pkgdir"/usr/share/licenses/$pkgname/LICENSE_1_0.txt

	./b2 $_options \
		--user-config="$builddir/user-config.jam" \
		--prefix="$pkgdir/usr" \
		--includedir="$pkgdir"/usr/include \
		--libdir="$pkgdir"/usr/lib \
		install

	install -Dm755 -t "$pkgdir"/usr/bin dist/bin/bcp b2
	ln -s b2 "$pkgdir"/usr/bin/bjam # old name for b2 binary
}

_boostlib() {
	local name="${subpkgname#"$pkgname"-}"
	pkgdesc="Boost $name shared library"

	# Claim the unversioned name, this must be removed once we switch our
	# boost to a new version
	depends=

	amove usr/lib/libboost_$name*.so.[0-9]*
}


_pyversion() {
	"$1" -c 'import sys; print("%i.%i" % (sys.version_info.major, sys.version_info.minor))'
}

sha512sums="
